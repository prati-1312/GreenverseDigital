---
layout: "base.njk"
title: "Contact | Greenverse Digital"
fullTitle: true
description: "Start a project with Greenverse Digital — a sustainable branding studio for purpose-led brands."
permalink: "/contact.html"
forms: true
---
<!-- ============== HERO ============== -->
  <section class="section hero hero--compact has-blob">
    <span class="blob blob--clay" aria-hidden="true" style="top: -160px; right: -160px;"></span>
    <div class="container">
      <p class="eyebrow hero__eyebrow" data-reveal>Contact</p>
      <h1 data-kinetic data-kinetic-stagger="110">
        Tell us about the <span class="accent-underline">brand</span> you're building.
      </h1>
      <p class="hero__lede" data-reveal data-reveal-delay="500">
        We work with a small number of purpose-led teams at a time. Share a few words about
        your project and we'll be in touch within two working days.
      </p>
    </div>
  </section>

  <!-- ============== PAGE BANNER ============== -->
  <section class="section" style="padding-block: 0;">
    <div class="container">
      <figure class="page-banner" data-reveal data-parallax="0.10">
        <img
          src="https://images.unsplash.com/photo-1499002238440-d264edd596ec?auto=format&fit=crop&w=1600&q=70"
          srcset="https://images.unsplash.com/photo-1499002238440-d264edd596ec?auto=format&fit=crop&w=900&q=70 900w,
                  https://images.unsplash.com/photo-1499002238440-d264edd596ec?auto=format&fit=crop&w=1400&q=70 1400w,
                  https://images.unsplash.com/photo-1499002238440-d264edd596ec?auto=format&fit=crop&w=1800&q=70 1800w"
          sizes="(max-width: 1180px) 100vw, 1180px"
          alt="Soft open sky over a quiet horizon."
          loading="lazy" decoding="async" width="1600" height="686">
        <div class="page-banner__overlay" aria-hidden="true"></div>
        <figcaption class="page-banner__caption">
          <span class="page-banner__tag">Begin</span>
          <span class="page-banner__line">A small note is enough — we'll take it from there.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============== CONTACT ============== -->
  <section class="section">
    <div class="container">
      <div class="split split--7-5">

        <!-- ---- Contact form ---- -->
        <!--
          This form prepares an email draft, not a server submission.
          A future backend needs an explicit integration in forms.js.
        -->
        <div data-reveal>
          <form
            id="contactForm"
            class="form"
            action="mailto:{{ site.email }}"
            method="post"
            enctype="text/plain"
            data-mailto="{{ site.email }}"
          >
            <div class="field">
              <label class="field__label" for="c-name">Your name</label>
              <input class="field__control" id="c-name" name="name" type="text" autocomplete="name" pattern=".*\S.*" required>
            </div>

            <div class="field">
              <label class="field__label" for="c-email">Email</label>
              <input class="field__control" id="c-email" name="email" type="email" autocomplete="email" required>
            </div>

            <div class="field">
              <label class="field__label" for="c-org">Brand or organisation <span class="t-meta">(optional)</span></label>
              <input class="field__control" id="c-org" name="organisation" type="text" autocomplete="organization">
            </div>

            <div class="field">
              <label class="field__label" for="c-message">A few words about your project</label>
              <textarea class="field__control" id="c-message" name="message" rows="6" required placeholder="What you're building, where you are in the journey, how we can help…"></textarea>
            </div>

            <div class="cluster justify-between">
              <button class="btn btn--primary" type="submit" data-magnetic="18">
                Prepare email draft <span class="btn__arrow" aria-hidden="true">→</span>
              </button>
              <p class="form__status" role="status" aria-live="polite"></p>
            </div>
            <p class="field__hint">This website does not send your enquiry. Review and send the draft in your email app, or <a href="mailto:{{ site.email }}">email us directly</a>.</p>
          </form>
        </div>

        <!-- ---- Direct contact ---- -->
        <aside data-reveal data-reveal-delay="120">
          <p class="eyebrow">Or reach us directly</p>
          <h2 class="mt-md">We read every message.</h2>

          <ul class="stack stack-md mt-lg" style="list-style: none; padding: 0;">
            <li>
              <p class="t-meta">Email</p>
              <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
            </li>
            <li>
              <p class="t-meta">Phone</p>
              <p><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></p>
            </li>
            <li>
              <p class="t-meta">Studio</p>
              <p>{{ site.location }}</p>
            </li>
            <li>
              <p class="t-meta">Social</p>
              <p>
                <a href="https://www.instagram.com/greenversedigital" target="_blank" rel="noopener noreferrer">Instagram</a>
                · <a href="https://www.linkedin.com/in/pratikshya-sahoo-658685347" target="_blank" rel="noopener noreferrer">LinkedIn</a>
              </p>
            </li>
          </ul>
        </aside>

      </div>
    </div>
  </section>
