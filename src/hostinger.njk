---
permalink: /.htaccess
eleventyExcludeFromCollections: true
---
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Canonical-host rules intentionally apply only to the two production hostnames.
RewriteCond %{HTTP_HOST} ^www\.greenversedigital\.com$ [NC]
RewriteRule ^ https://greenversedigital.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^greenversedigital\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://greenversedigital.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^Testimonials\.html$ /testimonials.html [R=301,L]
RewriteRule ^blog/blog/is-growing-sustainably-enough\.html$ /blog/is-growing-sustainably-enough.html [R=301,L]
# The unescaped question mark in the historical link started a query string.
RewriteRule "^blog/Is Growing Sustainably Enough.*$" /blog/is-growing-sustainably-enough.html [R=301,L,QSD]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self' mailto:; upgrade-insecure-requests"
</IfModule>
