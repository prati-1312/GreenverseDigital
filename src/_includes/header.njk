<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Greenverse Digital — home">
      <span class="site-header__logo-wrap" aria-hidden="true">
        <span class="site-header__logo-ring"></span>
        <span class="site-header__logo-glow"></span>
        <img class="site-header__logo" src="/images/Logo.jpg" alt="" width="44" height="44" decoding="async" fetchpriority="high">
      </span>
      <span class="site-header__wordmark">Greenverse</span>
    </a>

    <button
      class="nav-toggle hide-desktop"
      type="button"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__list">
        {% for item in navigation %}{% if item.label != "Contact" %}
        <li><a class="nav__link" href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% elif slug and item.label == "Blog" %} aria-current="location"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
      <a class="site-header__cta" href="/contact.html">Start a project</a>
    </nav>
  </div>
</header>
